<Project>
  <!--
    CI build support: when CI_SKIP_POST_BUILD is set (by the GitHub Actions workflow),
    replace CopyOutput and PackageMod with empty no-ops.
    CopyOutput writes to a local r2modman path and copies "Readme.md" (Windows
    case) which doesn't exist on Linux.  PackageMod calls PowerShell
    Compress-Archive.  The GitHub Actions workflow assembles the zip itself.
    On Windows (local builds) this env var is not set, so normal targets run.
  -->
  <Target Name="CopyOutput" AfterTargets="Build"
          Condition="'$(CI_SKIP_POST_BUILD)' != ''" />
  <Target Name="PackageMod"  AfterTargets="Build"
          Condition="'$(CI_SKIP_POST_BUILD)' != ''" />
</Project>
