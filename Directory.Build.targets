<Project>
  <!--
    CI build support: when CI_SKIP_POST_BUILD is set (by the GitHub Actions workflow),
    replace PackageMod with an empty no-op.
    PackageMod calls PowerShell Compress-Archive which doesn't exist on Linux.
    The GitHub Actions workflow assembles the zip itself.
    CopyOutput is safe on Linux now that the csproj uses README.md (correct case).
    On Windows (local builds) this env var is not set, so PackageMod runs normally.
  -->
  <Target Name="PackageMod" AfterTargets="Build"
          Condition="'$(CI_SKIP_POST_BUILD)' != ''" />
</Project>
