<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="4.0" DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <Import Project="packages\JotunnLib.2.26.1\build\JotunnLib.props" Condition="Exists('packages\JotunnLib.2.26.1\build\JotunnLib.props')" />
  <Import Project="$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props" Condition="Exists('$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props')" />
  <Import Project="environment.props" />
  <Import Project="packages\ILRepack.Lib.MSBuild.Task.2.0.43\build\ILRepack.Lib.MSBuild.Task.targets" Condition="Exists('packages\ILRepack.Lib.MSBuild.Task.2.0.43\build\ILRepack.Lib.MSBuild.Task.targets')" />
  <Import Project="ILRepack.targets" />

  <PropertyGroup>
    <Configuration Condition=" '$(Configuration)' == '' ">Debug</Configuration>
    <Platform Condition=" '$(Platform)' == '' ">AnyCPU</Platform>
    <ProjectGuid>{A1B2C3D4-E5F6-7890-ABCD-EF1234567890}</ProjectGuid>
    <OutputType>Library</OutputType>
    <AppDesignerFolder>Properties</AppDesignerFolder>
    <RootNamespace>DrakesReskinIt</RootNamespace>
    <AssemblyName>DrakesReskinIt</AssemblyName>
    <TargetFrameworkVersion>v4.8.1</TargetFrameworkVersion>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <FileAlignment>512</FileAlignment>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <Deterministic>true</Deterministic>
    <Optimize>false</Optimize>
  </PropertyGroup>

  <!-- ── Thunderstore packaging properties ── -->
  <PropertyGroup>
    <CompanyName>DrakeMods</CompanyName>
    <ThunderstoreBasePath>$(R2ModPath)</ThunderstoreBasePath>
    <ThunderstoreFolder>$(ThunderstoreBasePath)\ThunderstorePackage_ReskinIt</ThunderstoreFolder>
    <ZipOutput>$(ThunderstoreFolder)\$(CompanyName)-$(AssemblyName)-$(Version).zip</ZipOutput>
    <ManifestPath>$(ThunderstoreFolder)\manifest.json</ManifestPath>
    <Description>Per-item icon customization and recoloring addon for Valheim. Requires DrakesRenameit core libs.</Description>
    <WebsiteUrl>https://github.com/DrakeMods/DrakesReskinIt</WebsiteUrl>
    <Dependencies>["BepInEx-BepInExPack-5.4.2100", "ValheimModding-Jotunn-2.26.1", "DrakeMods-DrakesRenameit-1.0.0"]</Dependencies>
    <Version>1.0.0</Version>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|AnyCPU' ">
    <DebugSymbols>true</DebugSymbols>
    <DebugType>full</DebugType>
    <DefineConstants>DEBUG;TRACE</DefineConstants>
    <ErrorReport>prompt</ErrorReport>
    <WarningLevel>4</WarningLevel>
    <OutputPath>bin\Debug\</OutputPath>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|AnyCPU' ">
    <DebugType>pdbonly</DebugType>
    <DefineConstants>TRACE</DefineConstants>
    <ErrorReport>prompt</ErrorReport>
    <WarningLevel>4</WarningLevel>
    <OutputPath>bin\Release\</OutputPath>
    <Optimize>true</Optimize>
  </PropertyGroup>

  <!-- ── References: BepInEx / Harmony ── -->
  <ItemGroup>
    <Reference Include="0Harmony">
      <HintPath>$(BepInExPath)\core\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="BepInEx">
      <HintPath>$(BepInExPath)\core\BepInEx.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- ── References: Valheim publicized assemblies ── -->
  <ItemGroup>
    <Reference Include="assembly_guiframework">
      <HintPath>$(PublicizedAssembliesPath)\assembly_guiframework_publicized.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="assembly_valheim">
      <HintPath>$(PublicizedAssembliesPath)\assembly_valheim_publicized.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="assembly_utils">
      <HintPath>$(PublicizedAssembliesPath)\assembly_utils_publicized.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- ── References: Jotunn ── -->
  <ItemGroup>
    <Reference Include="Jotunn">
      <HintPath>packages\JotunnLib.2.26.1\lib\net462\Jotunn.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- ── References: ServerSync (IL-repacked into the output DLL) ── -->
  <ItemGroup>
    <Reference Include="ServerSync">
      <HintPath>libs\ServerSync.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

  <!-- ── References: Unity ── -->
  <ItemGroup>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(CorlibPath)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.ImageConversionModule">
      <HintPath>$(CorlibPath)\UnityEngine.ImageConversionModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.IMGUIModule">
      <HintPath>$(CorlibPath)\UnityEngine.IMGUIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.InputLegacyModule">
      <HintPath>$(CorlibPath)\UnityEngine.InputLegacyModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.AnimationModule">
      <HintPath>$(CorlibPath)\UnityEngine.AnimationModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.JSONSerializeModule">
      <HintPath>$(CorlibPath)\UnityEngine.JSONSerializeModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UI">
      <HintPath>$(CorlibPath)\UnityEngine.UI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="TMPro">
      <HintPath>$(CorlibPath)\unity.textmeshpro.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- ── References: Framework ── -->
  <ItemGroup>
    <Reference Include="Microsoft.CSharp" />
    <Reference Include="System" />
    <Reference Include="System.Core" />
    <Reference Include="System.Data" />
    <Reference Include="System.Xml" />
    <Reference Include="System.Xml.Linq" />
  </ItemGroup>

  <!-- ── Source files ── -->
  <ItemGroup>
    <Compile Include="DrakesReskinIt.cs" />
    <Compile Include="ReskinItConfig.cs" />
    <Compile Include="ReskinPatches.cs" />
    <Compile Include="ReskinPermissionManager.cs" />
    <Compile Include="ReskinExclusionRules.cs" />
    <Compile Include="IconRegistry.cs" />
    <Compile Include="ReskinUIPanels.cs" />
    <Compile Include="API\ReskinEvents.cs" />
    <Compile Include="API\ReskinItPermission.cs" />
    <Compile Include="extensions\ButtonExtensions.cs" />
    <Compile Include="Properties\AssemblyInfo.cs" />
  </ItemGroup>

  <!-- ── Content / non-compile files ── -->
  <ItemGroup>
    <Content Include="CHANGELOG.md">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="icon.png" Condition="Exists('icon.png')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="environment.props">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="libs\ServerSync.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="README.md">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!-- ── Assets ── -->
  <ItemGroup>
    <AssetFiles Include="Assets\**\*" />
  </ItemGroup>

  <!-- ── Post-build: copy to r2modman profile ── -->
  <Target Name="CopyOutput" AfterTargets="ILRepacker">
    <PropertyGroup>
      <PluginOutputDir>$(R2ModPath)\$(ProfileName)\BepInEx\plugins\$(CompanyName)-$(AssemblyName)\</PluginOutputDir>
    </PropertyGroup>
    <MakeDir Directories="$(PluginOutputDir)" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(PluginOutputDir)" OverwriteReadOnlyFiles="true" />
    <Copy SourceFiles="@(AssetFiles)" DestinationFolder="$(PluginOutputDir)Assets\%(RecursiveDir)"
          OverwriteReadOnlyFiles="true" Condition="'@(AssetFiles)' != ''" />
    <Copy SourceFiles="$(OutputPath)README.md" DestinationFolder="$(PluginOutputDir)"
          OverwriteReadOnlyFiles="true" Condition="Exists('$(OutputPath)README.md')" />
    <Copy SourceFiles="$(OutputPath)icon.png" DestinationFolder="$(PluginOutputDir)"
          OverwriteReadOnlyFiles="true" Condition="Exists('$(OutputPath)icon.png')" />
    <Copy SourceFiles="$(OutputPath)CHANGELOG.md" DestinationFolder="$(PluginOutputDir)"
          OverwriteReadOnlyFiles="true" Condition="Exists('$(OutputPath)CHANGELOG.md')" />
  </Target>

  <!-- ── Post-build: package for Thunderstore ── -->
  <Target Name="PackageMod" AfterTargets="CopyOutput">
    <MakeDir Directories="$(ThunderstoreFolder)" />
    <PropertyGroup>
      <ManifestContent>{"name":"$(AssemblyName)","version_number":"$(Version)","author":"$(CompanyName)","description":"$(Description)","website_url":"$(WebsiteUrl)","dependencies":$(Dependencies)}</ManifestContent>
    </PropertyGroup>
    <WriteLinesToFile File="$(ManifestPath)" Lines="$(ManifestContent)" Overwrite="true" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(ThunderstoreFolder)" OverwriteReadOnlyFiles="true" />
    <Copy SourceFiles="$(OutputPath)README.md" DestinationFolder="$(ThunderstoreFolder)"
          OverwriteReadOnlyFiles="true" Condition="Exists('$(OutputPath)README.md')" />
    <Copy SourceFiles="$(OutputPath)icon.png" DestinationFolder="$(ThunderstoreFolder)"
          OverwriteReadOnlyFiles="true" Condition="Exists('$(OutputPath)icon.png')" />
    <Copy SourceFiles="$(OutputPath)CHANGELOG.md" DestinationFolder="$(ThunderstoreFolder)"
          OverwriteReadOnlyFiles="true" Condition="Exists('$(OutputPath)CHANGELOG.md')" />
    <Exec Command="powershell -Command &quot;Compress-Archive -Path '$(ThunderstoreFolder)\*' -DestinationPath '$(ZipOutput)' -Force&quot;"
          ContinueOnError="true" />
  </Target>

  <!-- ── NuGet restore guard ── -->
  <Target Name="EnsureNuGetPackageBuildImports" BeforeTargets="PrepareForBuild">
    <PropertyGroup>
      <ErrorText>This project references NuGet package(s) that are missing. Restore packages before building.</ErrorText>
    </PropertyGroup>
    <Error Condition="!Exists('packages\JotunnLib.2.26.1\build\JotunnLib.props')" Text="$([System.String]::Format('$(ErrorText)', 'JotunnLib.2.26.1'))" />
  </Target>

</Project>
