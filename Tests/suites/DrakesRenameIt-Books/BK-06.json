{
  "name": "BK-06 shelf sizes: five pieces on the build grid, each with the right container and look",
  "description": "1 m and 2 m wall shelves, small (1x1 m), tall (1x2 m) and wide (2x1 m) bookcases are placeable with the container sizes their rows need; the old large bookcase is gone. One picture shows them side by side.",
  "steps": [
    {
      "do": "place",
      "prefab": "Drakes_WallShelf",
      "dz": 5,
      "dx": -5.0,
      "as": "wallshelf"
    },
    {
      "do": "hook",
      "name": "renameit.containerSize",
      "args": {
        "target": "wallshelf"
      },
      "expect": "8x1",
      "label": "Wall Shelf (1 m): 8 books"
    },
    {
      "do": "place",
      "prefab": "Drakes_WallShelfLong",
      "dz": 5,
      "dx": -3.0,
      "as": "wallshelflong"
    },
    {
      "do": "hook",
      "name": "renameit.containerSize",
      "args": {
        "target": "wallshelflong"
      },
      "expect": "8x2",
      "label": "Long Wall Shelf (2 m): 16 books"
    },
    {
      "do": "place",
      "prefab": "Drakes_BookcaseSmall",
      "dz": 5,
      "dx": -0.8,
      "as": "bookcasesmall"
    },
    {
      "do": "hook",
      "name": "renameit.containerSize",
      "args": {
        "target": "bookcasesmall"
      },
      "expect": "8x2",
      "label": "Small Bookcase (1x1 m, 2 rows)"
    },
    {
      "do": "place",
      "prefab": "Drakes_Bookcase",
      "dz": 5,
      "dx": 0.6,
      "as": "bookcase"
    },
    {
      "do": "hook",
      "name": "renameit.containerSize",
      "args": {
        "target": "bookcase"
      },
      "expect": "8x4",
      "label": "Tall Bookcase (1x2 m, 4 rows)"
    },
    {
      "do": "place",
      "prefab": "Drakes_BookcaseWide",
      "dz": 5,
      "dx": 2.8,
      "as": "bookcasewide"
    },
    {
      "do": "hook",
      "name": "renameit.containerSize",
      "args": {
        "target": "bookcasewide"
      },
      "expect": "8x4",
      "label": "Wide Bookcase (2x1 m, 2 long rows)"
    },
    {
      "do": "hook",
      "name": "renameit.hasPrefab",
      "args": {
        "name": "Drakes_BookcaseLarge"
      },
      "expect": false,
      "label": "the old large bookcase is gone"
    },
    {
      "do": "hook",
      "name": "renameit.closeBookWindows",
      "expect": true
    },
    {
      "do": "screenshot",
      "label": "all shelf sizes"
    }
  ],
  "asserts": [
    {
      "check": "noErrors",
      "source": "DrakesRenameit"
    }
  ]
}