{
  "name": "BK-14 placed book and page caret: flush, titled, hold to take, drawn icon, caret on sized text",
  "description": "A placed book lies flush with titles on spine and cover; the placer holds Use to take it back; the inventory icon is drawn from the cover. In Edit, the caret and selection follow text of different sizes.",
  "steps": [
    {
      "do": "hook",
      "name": "renameit.clearAround",
      "args": {
        "radius": 20
      }
    },
    {
      "do": "place",
      "prefab": "piece_workbench",
      "dz": 3,
      "dx": 3,
      "as": "bench"
    },
    {
      "do": "give",
      "materialsFor": "Drakes_Book"
    },
    {
      "do": "craft",
      "prefab": "Drakes_Book",
      "station": "bench"
    },
    {
      "do": "hook",
      "name": "renameit.bookWrite",
      "args": {
        "title": "Smithing Primer",
        "pages": "Heat|Hit|Quench",
        "color": 1,
        "size": 1
      },
      "expect": true
    },
    {
      "do": "hook",
      "name": "renameit.bookIcon",
      "contains": "drakes_book_icon_",
      "label": "the inventory icon is drawn from the cover"
    },
    {
      "do": "hook",
      "name": "renameit.bookPick",
      "expect": true
    },
    {
      "do": "place",
      "prefab": "Drakes_BookPiece",
      "dz": 2.0,
      "as": "book"
    },
    {
      "do": "wait",
      "seconds": 0.8
    },
    {
      "do": "hook",
      "name": "renameit.bookRest",
      "args": {
        "target": "book"
      },
      "contains": "flush",
      "label": "the book lies flush on the ground"
    },
    {
      "do": "hook",
      "name": "renameit.bookRest",
      "args": {
        "target": "book"
      },
      "contains": "titles=2",
      "label": "title on the spine and on the front cover"
    },
    {
      "do": "hook",
      "name": "renameit.bookHoverText",
      "args": {
        "target": "book"
      },
      "contains": "Take",
      "label": "the placer is offered hold to take"
    },
    {
      "do": "hook",
      "name": "renameit.hidePlayer",
      "args": {
        "on": true
      }
    },
    {
      "do": "hook",
      "name": "renameit.cameraZoom",
      "args": {
        "distance": 0.2
      }
    },
    {
      "do": "lookAt",
      "target": "book",
      "distance": 1.3
    },
    {
      "do": "wait",
      "seconds": 0.8
    },
    {
      "do": "screenshot",
      "label": "a placed book: flush, titled"
    },
    {
      "do": "hook",
      "name": "renameit.hidePlayer",
      "args": {
        "on": false
      }
    },
    {
      "do": "hook",
      "name": "renameit.bookHoldUse",
      "args": {
        "target": "book"
      },
      "expect": true,
      "label": "hold Use takes it"
    },
    {
      "do": "wait",
      "seconds": 0.8
    },
    {
      "do": "check",
      "check": "objectNear",
      "prefab": "Drakes_BookPiece",
      "radius": 4,
      "count": 0,
      "label": "the piece is gone"
    },
    {
      "do": "hook",
      "name": "renameit.bookIcon",
      "contains": "drakes_book_icon_",
      "label": "and the book is back in the inventory"
    },
    {
      "do": "hook",
      "name": "renameit.bookOpenReader",
      "args": {
        "tab": "pages",
        "edit": true
      },
      "expect": true
    },
    {
      "do": "wait",
      "seconds": 0.5
    },
    {
      "do": "hook",
      "name": "renameit.bookCaret",
      "args": {
        "text": "This is a <size=175%>big</size> book with <size=70%>small</size> words",
        "cursor": 13,
        "anchor": 10
      },
      "expect": true
    },
    {
      "do": "wait",
      "seconds": 0.8
    },
    {
      "do": "screenshot",
      "label": "edit: selection on the big word"
    },
    {
      "do": "hook",
      "name": "renameit.bookCaret",
      "args": {
        "text": "This is a <size=175%>big</size> book with <size=70%>small</size> words",
        "cursor": 18
      },
      "expect": true
    },
    {
      "do": "wait",
      "seconds": 0.8
    },
    {
      "do": "screenshot",
      "label": "edit: caret after book"
    },
    {
      "do": "hook",
      "name": "renameit.closeBookWindows",
      "expect": true
    }
  ],
  "asserts": [
    {
      "check": "noErrors",
      "source": "DrakesRenameit"
    }
  ]
}