{
  "name": "BK-20 cover colours: suggestions plus any colour from the picker, for the cover, the pattern and the spine lettering",
  "description": "The Cover tab keeps a few suggested colours per row and adds Any colour, the suite's colour picker. A picked colour is stored on the book, drawn on the icon and the spine. The settings scroll with a bar.",
  "steps": [
    {
      "do": "place",
      "prefab": "piece_workbench",
      "dz": 3,
      "dx": 3,
      "as": "bench"
    },
    {
      "do": "clearArea",
      "radius": 20
    },
    {
      "do": "give",
      "materialsFor": "Drakes_Book"
    },
    {
      "do": "craft",
      "prefab": "Drakes_Book",
      "station": "bench"
    },
    {
      "do": "hook",
      "name": "renameit.bookWriteAt",
      "args": {
        "index": 0,
        "title": "Custom Colours",
        "pages": "One|Two"
      }
    },
    {
      "do": "hook",
      "name": "renameit.bookOpenReader",
      "args": {
        "tab": "book"
      },
      "expect": true
    },
    {
      "do": "wait",
      "seconds": 0.6
    },
    {
      "do": "hook",
      "name": "renameit.uiText",
      "args": {
        "window": "reader"
      },
      "contains": "Any colour",
      "label": "each colour row has Any colour"
    },
    {
      "do": "hook",
      "name": "renameit.uiScroll",
      "args": {
        "window": "reader",
        "name": "drakes_book_settings_scroll"
      },
      "contains": "bar=",
      "label": "the settings are in a scroll area (informational)"
    },
    {
      "do": "hook",
      "name": "renameit.bookColour",
      "args": {
        "row": "cover",
        "hex": "#2F6F9F",
        "open": true
      },
      "expect": true
    },
    {
      "do": "wait",
      "seconds": 0.6
    },
    {
      "do": "hook",
      "name": "renameit.bookKey",
      "args": {
        "key": "color"
      },
      "contains": "2F6F9F",
      "label": "a custom cover colour is stored"
    },
    {
      "do": "screenshot",
      "name": "cover tab: any colour picker open",
      "label": "cover tab: any colour picker open",
      "clean": true
    },
    {
      "do": "hook",
      "name": "renameit.bookColour",
      "args": {
        "row": "accent",
        "hex": "#E0B040"
      },
      "expect": true
    },
    {
      "do": "hook",
      "name": "renameit.bookKey",
      "args": {
        "key": "accent"
      },
      "contains": "E0B040",
      "label": "a custom pattern colour"
    },
    {
      "do": "hook",
      "name": "renameit.bookColour",
      "args": {
        "row": "ink",
        "hex": "#101820"
      },
      "expect": true
    },
    {
      "do": "hook",
      "name": "renameit.bookKey",
      "args": {
        "key": "ink"
      },
      "contains": "101820",
      "label": "a custom spine lettering colour"
    },
    {
      "do": "wait",
      "seconds": 0.4
    },
    {
      "do": "screenshot",
      "name": "cover tab: custom cover, pattern and lettering",
      "label": "cover tab: custom cover, pattern and lettering",
      "clean": true
    },
    {
      "do": "hook",
      "name": "renameit.closeBookWindows"
    },
    {
      "do": "hook",
      "name": "renameit.bookIcon",
      "contains": "drakes_book_icon_",
      "label": "the icon is redrawn from the custom cover"
    }
  ],
  "asserts": [
    {
      "check": "noErrors",
      "source": "DrakesRenameit"
    }
  ]
}