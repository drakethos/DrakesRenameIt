{
  "name": "M-TC-105 landscape text looks right",
  "description": "Sheet: TC-105 step 9.",
  "manualOnly": true,
  "steps": [
    {
      "do": "setConfig",
      "values": {
        "10 Paper/BlankPaperPlaceOrientation": "Horizontal Only"
      }
    },
    {
      "do": "use",
      "block": "writePage",
      "args": {
        "text": "Look At Me",
        "desc": "LINE 1\nLINE 2\nLINE 3\nLINE 4"
      }
    },
    {
      "do": "use",
      "block": "pinPage"
    },
    {
      "do": "hook",
      "name": "renameit.pageStyle",
      "args": {
        "font": 7,
        "landscape": true
      }
    },
    {
      "do": "checkpoint",
      "message": "The page on the ground shows its text rotated 90 degrees with font 7 (only about LINE 1 and LINE 2 fit). Pass?"
    },
    {
      "do": "closeUi"
    }
  ],
  "asserts": [
    {
      "check": "noErrors",
      "source": "DrakesRenameit"
    }
  ]
}