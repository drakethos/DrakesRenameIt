{
  "name": "PN-01 renaming a chest someone else has open",
  "description": "Bjornita opens my chest (the game hands her the chest, as for any client). I rename it: RenameIt asks her client to write the name instead of taking the chest away from her (which closed it on her screen).",
  "steps": [
    { "do": "spawn", "prefab": "piece_chest_wood", "dz": 2.5, "owner": "me", "as": "chest" },
    { "do": "peerJoin", "name": "Bjornita" },
    { "do": "peerRpc", "peer": "Bjornita", "target": "chest", "method": "RPC_RequestOpen", "args": [ "@Bjornita" ], "types": [ "long" ] },
    { "do": "check", "check": "zdoOwner", "target": "chest", "expect": "Bjornita", "label": "Bjornita has the chest open (she owns it)" },
    { "do": "hook", "name": "renameit.pieceRename", "args": { "target": "chest", "text": "My Loot" }, "expect": true, "label": "I may rename my chest" },
    { "do": "wait", "seconds": 0.4 },
    { "do": "hook", "name": "renameit.pieceName", "args": { "target": "chest" }, "expect": "My Loot", "label": "her client wrote the name" },
    { "do": "check", "check": "zdoOwner", "target": "chest", "expect": "Bjornita", "label": "and she still has her chest" }
  ],
  "asserts": [ { "check": "noErrors", "source": "DrakesRenameit" } ]
}
