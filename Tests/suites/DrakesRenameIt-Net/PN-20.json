      "do": "hook",
      "name": "renameit.pieceShare",
      "args": {
        "target": "p0",
        "on": true
      },
      "expect": true,
      "label": "piece_chest_wood: I share it"
    },
    {
      "do": "peerRpc",
      "peer": "Bjornita",
      "target": "p0",
      "method": "DrakePiece_RPC_SetName",
      "args": [
        "Peer piece_chest_wood"
      ],
      "types": [
        "string"
      ]
    },
    {
      "do": "wait",
      "seconds": 0.3
    },
    {
      "do": "hook",
      "name": "renameit.pieceName",
      "args": {
        "target": "p0"
      },
      "contains": "Peer piece_chest_wood",
      "label": "piece_chest_wood: her rename was written"
    },
