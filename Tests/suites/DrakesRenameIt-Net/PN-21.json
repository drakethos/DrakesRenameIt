{
  "name": "PN-21 every kind of piece: renaming one her client owns goes to her",
  "description": "The sender side for 38 kinds of piece: I am the builder, she owns the piece, my rename must reach her client as an RPC and leave the owner alone.",
  "steps": [
    {
      "do": "setConfig",
      "values": {
        "12 Pieces/PieceRenameEnabled": "true",
        "12 Pieces/PieceRenameAdminOnly": "false",
        "12 Pieces/PieceExcludedCategory": "",
        "12 Pieces/PieceExcludedNames": "",
        "12 Pieces/PieceLockToBuilder": "true",
        "12 Pieces/PieceSharedEnabled": "true",
        "12 Pieces/PieceRequireWardAccess": "false"
      }
    },
    {
      "do": "peerJoin",
      "name": "Bjornita"
    },
    {
      "do": "spawn",
      "prefab": "piece_chest_wood",
      "dx": -10,
      "dz": 5,
      "owner": "me",
      "as": "p0"
    },
    {
      "do": "peerOwn",
      "peer": "Bjornita",
      "target": "p0"
    },
    {
      "do": "hook",
      "name": "renameit.pieceRename",
      "args": {
        "target": "p0",
        "text": "Mine piece_chest_wood"
      },
      "expect": true,
      "label": "piece_chest_wood: I may rename it"
    },
    {
      "do": "check",
      "check": "peerReceived",
      "target": "p0",
      "method": "DrakePiece_RPC_SetName",
      "types": [
        "string"
      ],
      "args": [
        "Mine piece_chest_wood"
      ],
      "label": "piece_chest_wood: the name went to her client"
    },
    {
      "do": "check",
      "check": "zdoOwner",
      "target": "p0",
      "expect": "Bjornita",
      "label": "piece_chest_wood: and she still owns it"
    },
