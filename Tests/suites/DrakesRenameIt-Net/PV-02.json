{
  "name": "PV-02 forged Shared switch is refused",
  "description": "Only the builder (or admin/VIP) may turn Shared on. A stranger's SetShared RPC must do nothing.",
  "steps": [
    {
      "do": "setConfig",
      "values": {
        "12 Pieces/PieceRenameEnabled": "true",
        "12 Pieces/PieceSharedEnabled": "true",
        "12 Pieces/PieceRequireWardAccess": "false"
      }
    },
    {
      "do": "spawn",
      "prefab": "piece_chest_wood",
      "dz": 2.5,
      "as": "chest",
      "owner": "me"
    },
    {
      "do": "peerJoin",
      "name": "Bjornita"
    },
    {
      "do": "peerRpc",
      "peer": "Bjornita",
      "target": "chest",
      "method": "DrakePiece_RPC_SetShared",
      "args": [
        true
      ],
      "types": [
        "bool"
      ]
    },
    {
      "do": "wait",
      "seconds": 0.5
    },
    {
      "do": "hook",
      "name": "renameit.pieceIsShared",
      "args": {
        "target": "chest"
      },
      "expect": false,
      "label": "still not shared"
    }
  ],
  "asserts": [
    {
      "check": "noErrors",
      "source": "DrakesRenameit"
    }
  ]
}