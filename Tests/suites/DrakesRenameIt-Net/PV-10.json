{
  "name": "PV-10 a Shared piece accepts a stranger's rename (control)",
  "description": "I build and share the chest; Bjornita's SetName is accepted. Guards against over-refusing.",
  "steps": [
    {
      "do": "setConfig",
      "values": {
        "12 Pieces/PieceRenameEnabled": "true",
        "12 Pieces/PieceRenameAdminOnly": "false",
        "12 Pieces/PieceExcludedCategory": "",
        "12 Pieces/PieceLockToBuilder": "true",
        "12 Pieces/PieceSharedEnabled": "true",
        "12 Pieces/PieceRequireWardAccess": "false"
      }
    },
    {
      "do": "spawn",
      "prefab": "piece_chest_wood",
      "dz": 2.5,
      "as": "chest",
      "owner": "me"
    },
    {
      "do": "hook",
      "name": "renameit.pieceShare",
      "args": {
        "target": "chest",
        "on": true
      },
      "expect": true,
      "label": "I share it"
    },
    {
      "do": "peerJoin",
      "name": "Bjornita"
    },
    {
      "do": "peerRpc",
      "peer": "Bjornita",
      "target": "chest",
      "method": "DrakePiece_RPC_SetName",
      "args": [
        "Shared Name"
      ],
      "types": [
        "string"
      ]
    },
    {
      "do": "wait",
      "seconds": 0.5
    },
    {
      "do": "hook",
      "name": "renameit.pieceName",
      "args": {
        "target": "chest"
      },
      "label": "accepted: shared",
      "contains": "Shared Name"
    }
  ],
  "asserts": [
    {
      "check": "noErrors",
      "source": "DrakesRenameit"
    }
  ]
}