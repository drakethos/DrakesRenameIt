{
  "name": "PV-11 forged name inside a ward that lists her is accepted (control)",
  "description": "My ward covers the chest and lists Bjornita. She built it, so her SetName is accepted: the ward rule must not refuse people the ward allows (checked with LockSmith loaded).",
  "steps": [
    {
      "do": "setConfig",
      "values": {
        "12 Pieces/PieceRenameEnabled": "true",
        "12 Pieces/PieceRenameAdminOnly": "false",
        "12 Pieces/PieceExcludedCategory": "",
        "12 Pieces/PieceLockToBuilder": "true",
        "12 Pieces/PieceRequireWardAccess": "true"
      }
    },
    {
      "do": "spawn",
      "prefab": "guard_stone",
      "dz": 0,
      "owner": "me",
      "enabled": true,
      "permitted": [
        "Bjornita"
      ],
      "as": "ward"
    },
    {
      "do": "spawn",
      "prefab": "piece_chest_wood",
      "dz": 2.5,
      "as": "chest",
      "owner": "Bjornita"
    },
    {
      "do": "peerJoin",
      "name": "Bjornita"
    },
    {
      "do": "peerRpc",
      "peer": "Bjornita",
      "target": "chest",
      "method": "DrakePiece_RPC_SetName",
      "args": [
        "Mine"
      ],
      "types": [
        "string"
      ]
    },
    {
      "do": "wait",
      "seconds": 0.5
    },
    {
      "do": "hook",
      "name": "renameit.pieceName",
      "args": {
        "target": "chest"
      },
      "label": "accepted: she is on the ward",
      "contains": "Mine"
    }
  ],
  "asserts": [
    {
      "check": "noErrors",
      "source": "DrakesRenameit"
    }
  ]
}