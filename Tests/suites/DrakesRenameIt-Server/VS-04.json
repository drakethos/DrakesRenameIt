{
  "name": "VS-04 a ward that does not list Player 2 stops her, shared or not",
  "description": "My ward covers the chest and does not list her. Shared does not help without ward access.",
  "steps": [
    {
      "do": "setConfig",
      "values": {
        "12 Pieces/PieceRenameEnabled": "true",
        "12 Pieces/PieceRenameAdminOnly": "false",
        "12 Pieces/PieceLockToBuilder": "true",
        "12 Pieces/PieceRequireWardAccess": "true",
        "12 Pieces/PieceSharedEnabled": "true"
      }
    },
    {
      "do": "spawn",
      "prefab": "guard_stone",
      "dz": -3,
      "owner": "me",
      "enabled": true,
      "radius": 15
    },
    {
      "do": "spawn",
      "prefab": "piece_chest_wood",
      "dz": 2.5,
      "owner": "me",
      "as": "chest"
    },
    {
      "do": "hook",
      "name": "renameit.pieceShare",
      "args": {
        "target": "chest",
        "on": true
      },
      "expect": true,
      "label": "I share it"
    },
    {
      "do": "wait",
      "seconds": 1
    },
    {
      "on": "player2",
      "do": "hook",
      "name": "renameit.pieceCan",
      "args": {
        "target": "chest"
      },
      "expect": false,
      "label": "Player 2 is not on the ward: she cannot"
    }
  ],
  "asserts": [
    {
      "check": "noErrors",
      "source": "DrakesRenameit"
    }
  ]
}