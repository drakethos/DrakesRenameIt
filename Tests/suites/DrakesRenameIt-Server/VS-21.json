{
  "name": "VS-21 every kind of piece: my rename reaches Player 2",
  "description": "I rename, she reads the name and hover title on her own client.",
  "steps": [
    {
      "do": "setConfig",
      "values": {
        "12 Pieces/PieceRenameEnabled": "true",
        "12 Pieces/PieceRenameAdminOnly": "false",
        "12 Pieces/PieceExcludedCategory": "",
        "12 Pieces/PieceExcludedNames": "",
        "12 Pieces/PieceLockToBuilder": "true",
        "12 Pieces/PieceSharedEnabled": "true",
        "12 Pieces/PieceRequireWardAccess": "false"
      }
    },
    {
      "do": "spawn",
      "prefab": "piece_chest_wood",
      "dx": -10,
      "dz": 5,
      "owner": "me",
      "as": "p0"
    },
    {
      "do": "hook",
      "name": "renameit.pieceRename",
      "args": {
        "target": "p0",
        "text": "P1 piece_chest_wood"
      },
      "expect": true,
      "label": "piece_chest_wood: I rename it"
    },
    {
      "do": "wait",
      "seconds": 1.5
    },
    {
