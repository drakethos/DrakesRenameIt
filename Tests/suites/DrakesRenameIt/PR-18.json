{
  "name": "PR-18 three players, one chest, one ward",
  "description": "Builder, a permitted non-builder and a stranger on one chest under one ward: who may rename and share, with the ward rule on and off.",
  "steps": [
    {
      "do": "playAs",
      "who": "Alice"
    },
    {
      "do": "spawn",
      "prefab": "piece_chest_wood",
      "dz": 2.5,
      "owner": "Alice",
      "as": "chest"
    },
    {
      "do": "spawn",
      "prefab": "guard_stone",
      "dz": -3,
      "owner": "Alice",
      "enabled": true,
      "radius": 15,
      "permitted": [
        "Bob"
      ]
    },
    {
      "do": "wait",
      "seconds": 0.5
    },
    {
      "do": "hook",
      "name": "renameit.pieceCan",
      "args": {
        "target": "chest"
      },
      "expect": true,
      "label": "Alice (builder, permitted by her own ward) may rename",
      "stop": true
    },
    {
      "do": "playAs",
      "who": "Bob"
    },
    {
      "do": "hook",
      "name": "renameit.pieceCan",
      "args": {
        "target": "chest"
      },
      "expect": false,
      "label": "Bob is on the ward but did not build it"
    },
    {
      "do": "hook",
      "name": "renameit.pieceShare",
      "args": {
        "target": "chest",
        "on": true
      },
      "expect": false,
      "label": "and cannot turn Shared on"
    },
    {
      "do": "playAs",
      "who": "Alice"
    },
    {
      "do": "hook",
      "name": "renameit.pieceShare",
      "args": {
        "target": "chest",
        "on": true
      },
      "expect": true,
      "label": "Alice shares it"
    },
    {
      "do": "playAs",
      "who": "Bob"
    },
    {
      "do": "hook",
      "name": "renameit.pieceCan",
      "args": {
        "target": "chest"
      },
      "expect": true,
      "label": "Shared + on the ward: Bob may rename"
    },
    {
      "do": "hook",
      "name": "renameit.pieceRename",
      "args": {
        "target": "chest",
        "text": "Bob and Alice"
      },
      "expect": true
    },
    {
      "do": "playAs",
      "who": "Carol"
    },
    {
      "do": "hook",
      "name": "renameit.pieceCan",
      "args": {
        "target": "chest"
      },
      "expect": false,
      "label": "Carol is not on the ward: shared does not help"
    },
    {
      "do": "hook",
      "name": "renameit.pieceRename",
      "args": {
        "target": "chest",
        "text": "Carol was here"
      },
      "expect": false,
      "label": "Carol cannot rename"
    },
    {
      "do": "hook",
      "name": "renameit.pieceName",
      "args": {
        "target": "chest"
      },
      "expect": "Bob and Alice",
      "label": "the name is still Bob and Alice"
    },
    {
      "do": "setConfig",
      "values": {
        "12 Pieces/PieceRequireWardAccess": "false"
      }
    },
    {
      "do": "hook",
      "name": "renameit.pieceCan",
      "args": {
        "target": "chest"
      },
      "expect": true,
      "label": "ward rule off: Carol may on a Shared piece"
    },
    {
      "do": "playAs",
      "who": "Alice"
    },
    {
      "do": "hook",
      "name": "renameit.pieceShare",
      "args": {
        "target": "chest",
        "on": false
      },
      "expect": true,
      "label": "Alice turns Shared off"
    },
    {
      "do": "playAs",
      "who": "Carol"
    },
    {
      "do": "hook",
      "name": "renameit.pieceCan",
      "args": {
        "target": "chest"
      },
      "expect": false,
      "label": "not shared: Carol cannot again"
    },
    {
      "do": "playAs",
      "who": "me"
    }
  ],
  "asserts": [
    {
      "check": "noErrors",
      "source": "DrakesRenameit"
    }
  ]
}