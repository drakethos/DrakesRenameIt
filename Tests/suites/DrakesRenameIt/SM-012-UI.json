{
  "name": "SM-012-UI pin a page on a real wall",
  "description": "Sheet: SM-012..014, TC-105 6-10. Formerly manual M-SM-012.",
  "steps": [
    {
      "do": "setConfig",
      "values": {
        "10 Paper/BlankPaperPlaceOrientation": "Vertical Only"
      }
    },
    "writePage(\"Wall Page\", \"On the wall\")",
    {
      "do": "place",
      "prefab": "woodwall",
      "dz": 3,
      "as": "wall"
    },
    {
      "do": "wait",
      "seconds": 0.3
    },
    {
      "do": "lookAt",
      "target": "wall",
      "distance": 2
    },
    {
      "do": "hook",
      "name": "renameit.clearPages"
    },
    {
      "do": "hook",
      "name": "renameit.pin",
      "args": {
        "prefab": "Drakes_Paper_Written",
        "wall": true
      },
      "expect": true,
      "label": "pinned on the wall where the crosshair is",
      "stop": true
    },
    {
      "do": "wait",
      "seconds": 1.0
    },
    {
      "do": "hook",
      "name": "renameit.pageName",
      "contains": "Wall Page",
      "label": "the wall page keeps its name"
    },
    {
      "do": "hook",
      "name": "renameit.pageMayEdit",
      "expect": true,
      "label": "Shift+E editing is allowed for the owner"
    },
    {
      "do": "screenshot",
      "name": "page-on-wall"
    },
    {
      "do": "hook",
      "name": "renameit.pageTake",
      "args": {
        "hold": true
      },
      "expect": true,
      "label": "hold E takes it"
    },
    {
      "do": "check",
      "check": "hasItem",
      "prefab": "Drakes_Paper_Written",
      "label": "back in the inventory"
    }
  ],
  "asserts": [
    {
      "check": "noErrors",
      "source": "DrakesRenameit"
    }
  ]
}