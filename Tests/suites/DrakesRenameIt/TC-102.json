  "description": "Sheet: TC-102. ",
  "steps": [
    {
      "do": "craft",
      "prefab": "AxeStone"
    },
    {
      "do": "use",
      "block": "editAll",
      "args": {
        "name": "Test Name",
        "desc": "Test Desc",
        "craftedBy": "Crafted in Test"
      }
    },
    {
