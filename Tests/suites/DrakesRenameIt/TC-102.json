    {
      "do": "use",
      "block": "checkAll",
      "args": {
        "name": "Test Name",
        "desc": "Test Desc",
        "craftedBy": "Crafted in Test"
      }
    }
  ],
  "asserts": [
    {
      "check": "noErrors",
      "source": "DrakesRenameit"
    }
  ]
}