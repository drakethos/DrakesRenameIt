{
  "description": "Craft an item through the game (real owner) and rename it; optionally give it a description too.",
  "params": {
    "prefab": "AxeStone",
    "by": null,
    "desc": null
  },
  "steps": [
    {
      "do": "craft",
      "prefab": "{{prefab}}",
      "by": "{{by}}"
    },
    {
      "do": "hook",
      "name": "renameit.edit",
      "args": {
        "prefab": "{{prefab}}",
        "op": "name",
        "text": "{{text}}"
      },
      "expect": true
    },
    {
      "if": "{{desc}}",
      "do": "hook",
      "name": "renameit.edit",
      "args": {
        "prefab": "{{prefab}}",
        "op": "desc",
        "text": "{{desc}}"
      },
      "expect": true
    }
  ]
}