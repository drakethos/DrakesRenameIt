{
  "description": "Set name, description and crafted-by on an item (each edit must succeed).",
  "params": [
    "name",
    "desc",
    "craftedBy",
    {
      "prefab": "AxeStone"
    }
  ],
  "actions": [
    {
      "do": "hook",
      "name": "renameit.edit",
      "args": {
        "prefab": "{{prefab}}",
        "op": "name",
        "text": "{{name}}"
      },
      "expect": true
    },
    {
      "do": "hook",
      "name": "renameit.edit",
      "args": {
        "prefab": "{{prefab}}",
        "op": "desc",
        "text": "{{desc}}"
      },
      "expect": true
    },
    {
      "do": "hook",
      "name": "renameit.edit",
      "args": {
        "prefab": "{{prefab}}",
        "op": "craftedBy",
        "text": "{{craftedBy}}"
      },
      "expect": true
    }
  ]
}