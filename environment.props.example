<Project>
  <PropertyGroup>
    <!-- Copy this file to environment.props and adjust paths for your machine. -->
    <ValheimGamePath>C:\Path\To\Valheim</ValheimGamePath>
    <R2ModPath>C:\Path\To\r2modmanPlus-local\Valheim\profiles</R2ModPath>
    <ProfileName>MyProfile</ProfileName>

    <!-- Derived paths used by the project -->
    <BepInExPath>$(R2ModPath)\$(ProfileName)\BepInEx</BepInExPath>
    <CorlibPath>$(ValheimGamePath)\valheim_Data\Managed</CorlibPath>
    <PublicizedAssembliesPath>$(ValheimGamePath)\valheim_Data\Managed\publicized_assemblies</PublicizedAssembliesPath>
  </PropertyGroup>
</Project>
