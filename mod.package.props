<Project>
  <PropertyGroup>
    <!-- Thunderstore package id — do not rename after publish -->
    <ThunderstoreName>DrakesRenameItLegacy</ThunderstoreName>
    <ThunderstoreAuthor>DrakeMods</ThunderstoreAuthor>
    <RootNamespace>DrakeRenameit</RootNamespace>
    <AssemblyName>DrakesRenameItLegacy</AssemblyName>
    <Version>1.0.0</Version>
    <!-- BepIn plugin display name — do not change (existing installs / docs) -->
    <BepInPluginName>DrakesRenameItLegacy</BepInPluginName>
    <BepInGuid>com.drakesworkshop.renameitlegacy</BepInGuid>
    <ModInfoClass>DrakeRenameit</ModInfoClass>
    <Description>Rename items, descriptions and Crafted by lines. Craftable Paper notes you can place. Standalone mono mod: no DrakeModsLibs, no other Drakes-mod integration.</Description>
    <WebsiteUrl>https://github.com/drakethos/DrakesRenameIt</WebsiteUrl>
    <DeployAfterTargets>CopyLocalizationToOutput</DeployAfterTargets>
    <!-- Standalone like DrakesEssentials: no DrakeModsLibs reference, vendor just what's needed under Vendor/. -->
    <EmbedServerSync>true</EmbedServerSync>
  </PropertyGroup>
  <ItemGroup>
    <ThunderstoreDependency Include="denikson-BepInExPack_Valheim-5.4.2351" />
    <ThunderstoreDependency Include="ValheimModding-Jotunn-2.30.2" />
  </ItemGroup>
</Project>
