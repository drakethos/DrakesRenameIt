<Project>
  <PropertyGroup>
    <!-- Thunderstore package id — do not rename after publish -->
    <ThunderstoreName>DrakesRenameit</ThunderstoreName>
    <ThunderstoreAuthor>DrakeMods</ThunderstoreAuthor>
    <RootNamespace>DrakeRenameit</RootNamespace>
    <AssemblyName>DrakesRenameit</AssemblyName>
    <Version>1.2.1</Version>
    <!-- BepIn plugin display name — do not change (existing installs / docs) -->
    <BepInPluginName>DrakesRenameit</BepInPluginName>
    <BepInGuid>com.drakesworkshop.renameit</BepInGuid>
    <ModInfoClass>DrakeRenameit</ModInfoClass>
    <Description>MOVING TO HEXIUM: final Thunderstore release, updates continue on Hexium. Rename items, descriptions and Crafted by lines. Craftable Paper notes you can place. Shared Lock|Rename tabs with LockSmith. Valheim 1.0.</Description>
    <WebsiteUrl>https://github.com/drakethos/DrakesRenameIt</WebsiteUrl>
    <DeployAfterTargets>CopyLocalizationToOutput</DeployAfterTargets>
  </PropertyGroup>
  <ItemGroup>
    <ThunderstoreDependency Include="denikson-BepInExPack_Valheim-5.4.2351" />
    <ThunderstoreDependency Include="ValheimModding-Jotunn-2.30.2" />
    <ThunderstoreDependency Include="DrakeMods-DrakeModsLibs-0.11.2" />
  </ItemGroup>
</Project>
